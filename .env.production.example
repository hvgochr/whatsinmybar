# Public hostname handled by Caddy. Do not include a scheme or path.
APP_DOMAIN=whatsinmybar.charradehugo.com

# Generate independent random values of at least 32 bytes for both secrets.
APP_SECRET=replace-with-a-random-application-secret
JWT_SECRET=replace-with-a-random-jwt-secret

POSTGRES_DB=whatsinmybar
POSTGRES_USER=whatsinmybar
POSTGRES_PASSWORD=replace-with-a-random-database-password

# URL-encode POSTGRES_PASSWORD before inserting it into DATABASE_URL.
DATABASE_URL=postgresql://whatsinmybar:replace-with-a-url-encoded-password@postgres:5432/whatsinmybar?serverVersion=16&charset=utf8

# Keep the regular expression anchored to the production frontend origin.
CORS_ALLOW_ORIGIN=^https://whatsinmybar\.charradehugo\.com$

# Required: inspect the existing shared Caddy container, do not guess this IP.
CADDY_PROXY_IP=
# Dedicated WhatsInMyBar SSR network; adjust all three if it overlaps the VPS.
APP_SUBNET=172.30.72.0/24
APP_IP_RANGE=172.30.72.128/25
WEB_INTERNAL_IP=172.30.72.3

# API_IMAGE and WEB_IMAGE are recorded by deploy.yml in .env.deploy.
