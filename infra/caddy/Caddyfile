{
	auto_https off
}

:80 {
	encode zstd gzip

	@api path /api* /uploads* /bundles* /_profiler* /_wdt*
	handle @api {
		reverse_proxy api:80 {
			header_up X-Forwarded-For {remote_host}
			header_up -Forwarded
			header_up -X-Real-IP
		}
	}

	handle {
		reverse_proxy web:3000 {
			header_up X-Forwarded-For {remote_host}
			header_up -Forwarded
			header_up -X-Real-IP
		}
	}
}
