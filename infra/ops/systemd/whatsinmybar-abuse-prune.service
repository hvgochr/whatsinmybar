[Unit]
Description=Prune expired WhatsInMyBar abuse counters
Requires=docker.service
After=docker.service
OnFailure=whatsinmybar-alert@%n.service

[Service]
Type=oneshot
User=hugo
Group=hugo
WorkingDirectory=/srv/whatsinmybar
ExecStart=/usr/bin/flock -w 900 .ops.lock /usr/bin/docker compose --env-file .env.prod --env-file .env.deploy -f compose.prod.yaml exec -T api php bin/console app:abuse:prune
TimeoutStartSec=20min
UMask=0077
