[Unit]
Description=WhatsInMyBar database and upload backup
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target
OnFailure=whatsinmybar-alert@%n.service

[Service]
Type=oneshot
User=hugo
Group=hugo
WorkingDirectory=/srv/whatsinmybar
EnvironmentFile=/etc/whatsinmybar/backup.env
ExecStart=/usr/bin/bash infra/ops/backup.sh
TimeoutStartSec=30min
UMask=0077
